@startuml PrintReceipt
!theme plain
title Activity Diagram – Print Receipt

start

if (Customer wants a Receipt?) then (yes)
  :ATM retrieves current Account balance;
  :ATM retrieves Card cardNumber\nfrom Session and masks it;
  :ATM generates Receipt\nwith Transaction details,\nAccount balance,\nand masked Card cardNumber;
  :ATM prints Receipt;
else (no)
endif

stop

@enduml
