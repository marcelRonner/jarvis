@startuml orderCoffee
!theme plain
title Activity Diagram – Order Coffee

start

:Customer selects Coffee\nfrom transaction menu;

:ATM checks CoffeeMachine\nstatus and beansRemaining;

if (CoffeeMachine ONLINE\nand beansRemaining > 0?) then (yes)
  :ATM creates BeverageOrder\n(status = PENDING);
  :CoffeeMachine dispenses\nEspresso;
  :ATM updates BeverageOrder\n(status = COMPLETED);
  :ATM decrements\nCoffeeMachine beansRemaining;
  :Bank Backend writes\nAuditLog entry;
  stop
else (no)
  :ATM updates BeverageOrder\n(status = FAILED);
  :ATM displays "CoffeeMachine\nout of service";
  stop
endif

@enduml
